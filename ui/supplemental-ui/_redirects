/quickstart      /maildeno/quickstart.html      301
/sdk             /maildeno/sdk/overview.html    301
/sdk/js          /maildeno/sdk/javascript.html  301
/sdk/python      /maildeno/sdk/python.html      301
/builder         /maildeno/builder/overview.html 301

