{
  "name": "maildeno-docs",
  "version": "1.0.0",
  "description": "Maildeno official documentation site powered by Antora",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "antora --fetch antora-playbook.yml",
    "build:local": "antora antora-playbook-local.yml",
    "serve": "npx http-server build/site -p 5000 -c-1 --cors -o",
    "dev": "npm run build:local && npm run serve",
    "clean": "rm -rf build",
    "build:ci": "antora antora-playbook-local.yml"
  },
  "devDependencies": {
    "@antora/cli": "3.1.9",
    "@antora/site-generator": "3.1.9",
    "http-server": "^14.1.1",
    "@asciidoctor/tabs": "^1.0.0-beta.6"
  }
}
