# ui/supplemental-ui/_headers
# Cloudflare Pages HTTP response headers.
# Applied to every response from the deployed site.
# See: https://developers.cloudflare.com/pages/configuration/headers/

/*
  # Prevent MIME-type sniffing
  X-Content-Type-Options: nosniff

  # Clickjacking protection
  X-Frame-Options: DENY

  # XSS protection (legacy browsers)
  X-XSS-Protection: 1; mode=block

  # Referrer policy
  Referrer-Policy: strict-origin-when-cross-origin

  # Permissions policy — restrict unused browser features
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

  # Content Security Policy — tighten as needed for your analytics / fonts
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com; frame-ancestors 'none';

# Long-lived cache for hashed static assets
/maildeno/_/*
  Cache-Control: public, max-age=31536000, immutable

# HTML pages — revalidate on each visit
/*.html
  Cache-Control: public, max-age=0, must-revalidate
